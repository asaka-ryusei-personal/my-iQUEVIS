# ====================================
# 既存の Next.js 用設定
# ====================================
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ====================================
# Backend (Java / Gradle)
# ====================================
backend/.gradle/
backend/build/
backend/out/
.gradle/
build/

# ====================================
# Database
# ====================================
db/data/

# ====================================
# Docker
# ====================================
*.pid
*.seed
docker-compose.override.yml

# ====================================
# IDE / Editor settings
# ====================================
.vscode/
.idea/
